{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "com.chess-sensei.app",
  "version": "1.0.4",
  "applicationName": "Chess-Sensei",
  "author": "Jhon D. Vise",
  "description": "A modern chess training application with real-time AI-assisted move guidance",
  "defaultMode": "window",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "url": "/",
  "port": 0,
  "documentRoot": "/app/",
  "logging": {
    "enabled": true,
    "writeToLogFile": true
  },
  "nativeAllowList": [
    "events.*",
    "app.*",
    "os.*",
    "debug.log",
    "window.setMainMenu",
    "window.print",
    "clipboard.writeHTML"
  ],
  "modes": {
    "window": {
      "title": "Chess-Sensei",
      "width": 1200,
      "height": 1000,
      "minWidth": 400,
      "minHeight": 600,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/app/icon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "exitProcessOnClose": true,
      "injectGlobals": true,
      "injectClientLibrary": true
    }
  },
  "cli": {
    "binaryName": "chess-sensei",
    "resourcesPath": "/app/",
    "extensionsPath": "/extensions/",
    "distributionPath": "dist",
    "binaryVersion": "6.4.0",
    "clientVersion": "6.4.0"
  }
}
